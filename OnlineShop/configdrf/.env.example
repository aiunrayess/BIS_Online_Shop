# Copy this file to .env and replace the placeholder before starting Django.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Leave DATABASE_URL unset for local SQLite. Production uses PostgreSQL with
# TLS and the connection pool/health-check settings below. Do not commit a
# real username or password.
# DATABASE_URL=postgresql://onlineshop:replace-me@db.example:5432/onlineshop?sslmode=require
# DJANGO_DB_CONN_MAX_AGE=60
# DJANGO_DB_SSLMODE=require

# Production defaults are secure. Set this to False only when a trusted TLS
# terminating proxy forwards HTTP to this local Django process.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_USE_X_FORWARDED_PROTO=True
