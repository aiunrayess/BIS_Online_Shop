# Copy to configdrf/.env.postgres and replace every development-only value.
# This file is for the local Docker PostgreSQL service in compose.postgres.yml.
# Do not commit configdrf/.env.postgres or use these credentials in production.

POSTGRES_DB=onlineshop
POSTGRES_USER=onlineshop
POSTGRES_PASSWORD=replace-with-a-long-local-development-password
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=replace-with-a-long-random-local-development-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
DATABASE_URL=postgresql://onlineshop:replace-with-a-long-local-development-password@127.0.0.1:5432/onlineshop?sslmode=disable
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_DB_SSLMODE=disable
